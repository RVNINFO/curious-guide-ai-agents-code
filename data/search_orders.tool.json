{
  "name": "search_orders",
  "description": "Find orders by email. Use when no order ID is known.",
  "parameters": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "description": "The customer's email address."
      },
      "status": {
        "type": "string",
        "enum": ["pending", "shipped", "delivered", "canceled"],
        "description": "Optional filter. Omit to return all statuses."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "default": 10,
        "description": "How many orders to return."
      }
    },
    "required": ["email"]
  }
}
